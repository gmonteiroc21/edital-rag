# Copie para .env e preencha. O .env está no .gitignore — não commite.

# Obrigatório: chave da API da Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Modelo. claude-opus-5 é o padrão; claude-sonnet-5 é mais barato.
EDITAL_RAG_MODEL=claude-opus-5

# Esforço de raciocínio: low | medium | high | xhigh | max
# "low" é adequado aqui — a tarefa é sintetizar contexto já recuperado,
# não raciocinar do zero. Suba para "medium" se as respostas ficarem rasas.
EDITAL_RAG_EFFORT=low

# Caminho do banco SQLite (índice vetorial)
EDITAL_RAG_DB_PATH=data/index.db

# Quantos chunks recuperar por pergunta
EDITAL_RAG_TOP_K=6
